# ---------------------------------------------------------------------------
# LLM BACKEND  —  switching providers is a one-line change
# ---------------------------------------------------------------------------
#
# Pick a provider, then give it a key. That's it.
#
#   LLM_PROVIDER=deepseek
#   LLM_API_KEY=sk-...
#
# Supported values for LLM_PROVIDER:
#
#   deepseek     DeepSeek            (default)  DEEPSEEK_API_KEY | LLM_API_KEY
#   openai       OpenAI                         OPENAI_API_KEY   | LLM_API_KEY
#   gemini       Google Gemini                  GEMINI_API_KEY   | GOOGLE_API_KEY | LLM_API_KEY
#   anthropic    Anthropic Claude               ANTHROPIC_API_KEY| LLM_API_KEY
#   openrouter   OpenRouter                     OPENROUTER_API_KEY | LLM_API_KEY
#   groq         Groq                           GROQ_API_KEY     | LLM_API_KEY
#   ollama       local Ollama (no key needed)   OLLAMA_API_KEY (optional)
#   custom       any OpenAI-compatible endpoint requires LLM_BASE_URL + LLM_MODEL
#
# A provider-specific key wins over LLM_API_KEY, so you can keep several keys in
# this file and switch by changing LLM_PROVIDER alone.

LLM_PROVIDER=deepseek

# Generic key, used when no provider-specific key is set.
LLM_API_KEY=

# Optional: override the provider's default model.
#   deepseek-chat (default, fast)  |  deepseek-reasoner (slower, stronger)
#   gpt-4o-mini  |  gemini-2.5-flash  |  claude-sonnet-4-5
LLM_MODEL=

# Optional: override the API endpoint (required for LLM_PROVIDER=custom).
#   deepseek     https://api.deepseek.com        (https://api.deepseek.com/v1 also works)
#   openai       https://api.openai.com/v1
#   gemini       (built in)
#   anthropic    https://api.anthropic.com/v1
#   ollama       http://localhost:11434/v1
LLM_BASE_URL=

# Per-request timeout in seconds, and retry count for transient failures.
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# Upper bound on generated tokens (used by Gemini and Anthropic).
LLM_MAX_TOKENS=4096

# Extra HTTP headers as JSON — handy for gateways that need routing headers.
# LLM_EXTRA_HEADERS={"HTTP-Referer": "https://example.com", "X-Title": "yt-summarizer"}

# ---------------------------------------------------------------------------
# TRANSCRIPTS
# ---------------------------------------------------------------------------

# Language preference order when a video has multiple caption tracks.
TRANSCRIPT_LANGUAGES=en,ru,fr

# Transcripts longer than this are truncated before summarization. The summary
# tells the user when that happened.
MAX_TRANSCRIPT_CHARS=400000

# Netscape-format cookie file, only needed for age/region-restricted videos.
# Never commit this file.
COOKIES_FILE=cookies.txt

# Clear yt-dlp's cache at startup (helps after YouTube bot-detection lockouts).
YTDLP_CLEAR_CACHE=true

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------

# Required in production: a stable key keeps sessions valid across restarts and
# across worker processes. Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

HOST=127.0.0.1
PORT=5001

# Never enable this on a reachable address: the Werkzeug debugger allows RCE.
DEBUG=false

# Set to true when serving over HTTPS.
SESSION_COOKIE_SECURE=false

# Conversation lifetime and how many conversations to keep in memory.
SESSION_TTL_SECONDS=3600
SESSION_MAX=256

# Requests per minute, per browser session. Protects your LLM quota.
RATE_LIMIT_PER_MINUTE=20

# Timeout for transcript/HTTP fetches.
HTTP_TIMEOUT=20

LOG_LEVEL=INFO
